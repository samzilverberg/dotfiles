{{- /*
  Machine config, generated by `chezmoi init`. Re-run `chezmoi init` after editing this file.

  profiles: extra layers applied on top of the base dotfiles (see .chezmoidata/profiles.yaml).
  Asked once per machine; change later with `chezmoi init --prompt`,
  or non-interactively: `DOTFILES_PROFILES=payzen chezmoi init` (comma or space separated; "none" for none).
*/ -}}
{{- $profilesCsv := env "DOTFILES_PROFILES" -}}
{{- if eq $profilesCsv "none" -}}
{{-   $profilesCsv = "" -}}
{{- else if not $profilesCsv -}}
{{-   if stdinIsATTY -}}
{{-     $profilesCsv = promptStringOnce . "profilesCsv" "Extra profiles for this machine (e.g. payzen; empty for none)" "" -}}
{{-   else if hasKey . "profilesCsv" -}}
{{-     $profilesCsv = .profilesCsv -}}
{{-   end -}}
{{- end -}}
{{- $profilesCsv = $profilesCsv | replace " " "," -}}
{{- $profiles := list -}}
{{- range (splitList "," $profilesCsv) -}}
{{-   $p := trim . -}}
{{-   if $p }}{{ $profiles = append $profiles $p }}{{ end -}}
{{- end -}}

sourceDir = "~/dotfiles"
mode = "symlink"
# dirs chezmoi creates/manages are 700, generated files 600 (matches what macOS apps
# create under ~ and keeps chezmoi from loosening ~/.config etc. to 755)
umask = 0o077

[data]
    profilesCsv = {{ $profilesCsv | quote }}
    profiles = {{ $profiles | toJson }}

[git]
    autoPush = false

[diff]
    exclude = ["scripts"]

# snapshot app settings that can't be plain dotfiles into macos/ (see macos/app-settings),
# so status/diff/apply/git always see current settings. Never fails the chezmoi command.
[hooks.read-source-state.pre]
    command = "/bin/sh"
    args = ["-c", "[ -x \"$CHEZMOI_WORKING_TREE/macos/app-settings\" ] && \"$CHEZMOI_WORKING_TREE/macos/app-settings\" export; true"]
[hooks.git.pre]
    command = "/bin/sh"
    args = ["-c", "[ -x \"$CHEZMOI_WORKING_TREE/macos/app-settings\" ] && \"$CHEZMOI_WORKING_TREE/macos/app-settings\" export; true"]

[onepassword]
{{- if eq .chezmoi.os "darwin" }}
    # absolute path: on a fresh mac, brew (and op) are installed by the bootstrap
    # script during the first apply, so they are not on chezmoi's PATH yet
    command = {{ if eq .chezmoi.arch "arm64" }}"/opt/homebrew/bin/op"{{ else }}"/usr/local/bin/op"{{ end }}
{{- else }}
    command = "op"
{{- end }}
