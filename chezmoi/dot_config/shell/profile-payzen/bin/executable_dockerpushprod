#!/bin/sh
# re-tag and push the staging ECR image of the package in $PWD to the prod ECR
# needs PZ_AWS_ACCOUNT_STAGING / PZ_AWS_ACCOUNT_PROD (profile-payzen/env.sh, from 1Password)
set -eu
: "${PZ_AWS_ACCOUNT_STAGING:?missing, see ~/.config/shell/profile-payzen/env.sh}"
: "${PZ_AWS_ACCOUNT_PROD:?missing, see ~/.config/shell/profile-payzen/env.sh}"
[ -e package.json ] || { echo "no package.json in directory, check that you are in right place to run cmd" >&2; exit 1; }
pkg_version=$(npm pkg get version | tr -d '"')
pkg_name=$(npm pkg get name | tr -d '"@')
img="$pkg_name:$pkg_version"
stg_img="$PZ_AWS_ACCOUNT_STAGING.dkr.ecr.us-east-1.amazonaws.com/$img"
prod_img="$PZ_AWS_ACCOUNT_PROD.dkr.ecr.us-east-1.amazonaws.com/$img"
if [ -z "$(docker images -q --filter=reference="$stg_img")" ]; then
  echo "image not found, pulling it first"
  echo "docker pull $stg_img"
  docker pull "$stg_img"
fi
echo "going to re-tag and push $img from aws staging account to prod"
echo "  if it fails maybe you need to docker login to aws ecr"
echo "docker tag $stg_img $prod_img"
docker tag "$stg_img" "$prod_img"
echo "docker push $prod_img"
docker push "$prod_img"
