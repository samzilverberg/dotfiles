#!/bin/sh
# (re)generate kubeconfig contexts for the payzen EKS clusters via aws sso (replaces the kube configs
# that used to be committed). Login first: aws sso login
set -eu
add() { # <context-alias> <cluster> <region> <aws-profile> [kubeconfig]
  aws eks update-kubeconfig --alias "$1" --name "$2" --region "$3" --profile "$4" ${5:+--kubeconfig "$5"}
}
add staging eks-staging-01 us-east-1 default
add sandbox eks-sandbox us-east-1 default
add prod eks-production-01 us-east-1 prod
add buildkit buildkit il-central-1 default "$HOME/.kube/config-builder.yaml"
