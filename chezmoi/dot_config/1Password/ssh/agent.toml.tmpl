# 1Password SSH agent: which keys it offers (default is only the Personal/Private vault).
# https://developer.1password.com/docs/ssh/agent/config
# Order matters: servers like GitHub accept the first key that matches an account.

[[ssh-keys]]
vault = "dotfiles"
{{- if has "payzen" .profiles }}

# payzen profile: work key, kept in the PayZen account's Employee vault
[[ssh-keys]]
item = "ssh-payzen-dev docu"
vault = "Employee"
account = "PayZen"
{{- end }}
