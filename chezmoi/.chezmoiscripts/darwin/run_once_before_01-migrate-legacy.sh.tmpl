#!/usr/bin/env bash
# One-time migration from the 2025 layout (only matters on machines that ran it):
# files that are no longer managed were symlinks into the repo. Turn the ones worth keeping into
# real files (content from git history) before the prune script removes them as dangling.
set -euo pipefail
repo={{ .chezmoi.workingTree | quote }}
src={{ .chezmoi.sourceDir | quote }}

materialize() { # <target> <path in repo>
  local target=$1 path=$2 rev tmp
  [ -L "$target" ] || return 0
  case "$(readlink "$target")" in "$src"/*) ;; *) return 0 ;; esac
  [ -e "$target" ] && { cp -L "$target" "$target.tmp.$$" && mv -f "$target.tmp.$$" "$target"; return 0; }
  rev=$(git -C "$repo" rev-list -n 1 HEAD -- "$path" 2>/dev/null || true)
  [ -n "$rev" ] || { echo "cannot find $path in git history, leaving $target" >&2; return 0; }
  # rev is either the commit that deleted the file (content is in its parent) or the last one that had it
  git -C "$repo" cat-file -e "$rev:$path" 2>/dev/null || rev="$rev^"
  tmp="$target.tmp.$$"
  if git -C "$repo" show "$rev:$path" >"$tmp" 2>/dev/null; then
    chmod 600 "$tmp" && mv -f "$tmp" "$target" && echo "now a real (unmanaged) file: $target"
  else
    rm -f "$tmp"
  fi
}

release() { # <target>: now generated by a create_ template. Keep current content as a real file,
  # or drop a dangling link so the template can write it (chezmoi won't create over an existing path)
  local target=$1
  [ -L "$target" ] || return 0
  case "$(readlink "$target")" in "$src"/*) ;; *) return 0 ;; esac
  if [ -e "$target" ]; then
    cp -L "$target" "$target.tmp.$$" && chmod 600 "$target.tmp.$$" && mv -f "$target.tmp.$$" "$target"
  else
    rm -f "$target" && echo "removed dangling $target (will be generated from 1Password)"
  fi
}

materialize "$HOME/.kube/config-builder.yaml" chezmoi/dot_kube/config-builder.yaml
materialize "$HOME/.docker/config.json" chezmoi/dot_docker/config.json
release "$HOME/.gitconfig-payzen"
release "$HOME/.aws/config"
