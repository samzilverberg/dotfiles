#!/usr/bin/env bash
# Installs packages from .chezmoidata/packages.yaml (base + this machine's profiles: {{ .profiles | join ", " }}).
# run_onchange: re-runs whenever the rendered package list changes. Never uninstalls anything.
# after_: dotfiles are written first, so one failing package can't block them (bootstrap already
# installed what the apply itself needs). A failure still exits non-zero, so the next apply retries.
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$b" ] && { eval "$("$b" shellenv)"; break; }
done

# --no-upgrade: install what's missing only; upgrades stay a separate `brew upgrade`
brew bundle --no-upgrade --file=/dev/stdin <<'EOF'
{{- $sets := list .packages.darwin }}
{{- range .profiles }}{{ with index $.packages.profiles . }}{{ with .darwin }}{{ $sets = append $sets . }}{{ end }}{{ end }}{{ end }}
{{- range $sets }}{{ range .taps }}
tap {{ . | quote }}
{{- end }}{{ end }}
{{- range $sets }}{{ range .brews }}
brew {{ . | quote }}
{{- end }}{{ end }}
{{- range $sets }}{{ range .casks }}
cask {{ . | quote }}
{{- end }}{{ end }}
EOF

# zsh compinit refuses group-writable completion dirs (aborts => no completions at all);
# Homebrew creates $HOMEBREW_PREFIX/share as 775
chmod go-w "$HOMEBREW_PREFIX/share" "$HOMEBREW_PREFIX/share/zsh" "$HOMEBREW_PREFIX/share/zsh/site-functions" 2>/dev/null || true

# install.sh put chezmoi in ~/.local/bin (first on PATH); once brew's exists, drop the copy so it
# doesn't shadow brew's (and never gets upgraded)
if [ -x "$HOME/.local/bin/chezmoi" ] && [ -x "$HOMEBREW_PREFIX/bin/chezmoi" ]; then
  rm -f "$HOME/.local/bin/chezmoi"
  echo "removed ~/.local/bin/chezmoi (brew's chezmoi is used now)"
fi
{{- else if eq .chezmoi.os "linux" }}
SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

if command -v apt-get >/dev/null 2>&1; then
  $SUDO apt-get update -qq
  $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y {{ .packages.apt | join " " }}
elif command -v dnf >/dev/null 2>&1; then
  $SUDO dnf install -y {{ .packages.dnf | join " " }}
fi

mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

# Debian/Ubuntu install fd as `fdfind`; tools (fzf.fish) expect `fd`
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi
{{- range .packages.linux_installers }}
{{-   if eq . "starship" }}
command -v starship >/dev/null 2>&1 || curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
{{-   else if eq . "mise" }}
command -v mise >/dev/null 2>&1 || curl -fsSL https://mise.run | sh
{{-   end }}
{{- end }}
{{- end }}
