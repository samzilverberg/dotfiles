#!/usr/bin/env bash

{{ if eq .chezmoi.os "darwin" }}
# install package manager (brew) and gain access to secrets (1pass)

if [[ ! $(command -v brew) ]]; then
    header "🍺  Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [[ ! $(command -v op) ]]; then
    brew bundle --file=/dev/stdin <<EOF
brew "fish"
brew "git"
brew "gnupg2"
brew "pinentry-mac"
cask "1password-cli"
cask "1password"
EOF
fi
{{ end -}}

# set fish as shell default shell, might need to logout -> login after
echo $SHELL | grep -q -v zsh && chsh -s $(which fish) && echo "LOGOUT+LOGIN is required for zsh to work"
! grep -q fish /etc/shells && echo $(which fish) | sudo tee -a /etc/shells
# this replace the manual 
# "system settings -> Users and Groups -> unlock -> ctrl + click username -> advanced -> put full path of fish in \"Login shell\"
sudo dscl . -read /Users/$USER UserShell | grep -q fish && sudo dscl . -create /Users/$USER UserShell $(which fish)


if [[ ! $(op account list | grep samzilverberg) ]]; then
  # TODO echo with RED color
  printf '
  =====================================================================
  not logged in to 1pass.
  open 1pass, login and enable cli integration from settings->developer
  =====================================================================
  '
  exit 1
fi

if [[ $(op account list | grep samzilverberg) ]]; then
  echo "logged in to 1pass, can continue"
fi
