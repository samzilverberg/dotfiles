# bash: shared env + PATH + aliases from ~/.config/shell (same layer as fish / zsh)
[ -f "$HOME/.config/shell/load-env.sh" ] && . "$HOME/.config/shell/load-env.sh"

case $- in *i*) ;; *) return ;; esac # below: interactive only

[ -f "$HOME/.config/shell/load-interactive.sh" ] && . "$HOME/.config/shell/load-interactive.sh"

for _f in /opt/homebrew/etc/profile.d/bash_completion.sh /usr/share/bash-completion/bash_completion; do
  [ -r "$_f" ] && { . "$_f"; break; }
done
unset _f

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash --cmd cd)"
command -v mise >/dev/null 2>&1 && eval "$(mise activate bash)"
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"
