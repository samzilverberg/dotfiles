# Interactive zsh. fish is the daily shell; this keeps zsh (opened by apps/agents) close to it.
# env + PATH: ~/.zshenv -> ~/.config/shell/load-env.sh. Aliases: ~/.config/shell/load-interactive.sh

# make paste instant instead of slow one by one char
# https://github.com/zsh-users/zsh-syntax-highlighting/issues/295#issuecomment-214581607
zstyle ':bracketed-paste-magic' active-widgets '.self-*'

setopt extended_history
HISTFILE="$HOME/.histfile"
HISTSIZE=20000
SAVEHIST=20000

# Antigen (oh-my-zsh + plugins, see ~/.zshrc_antigen)
for _antigen in \
  /opt/homebrew/share/antigen/antigen.zsh \
  /usr/local/share/antigen/antigen.zsh \
  /usr/share/zsh-antigen/antigen.zsh \
  /usr/share/zsh/share/antigen.zsh; do
  if [ -f "$_antigen" ]; then
    source "$_antigen"
    antigen init ~/.zshrc_antigen
    break
  fi
done
unset _antigen

# shared aliases (same as fish) + profile aliases
[ -f "$HOME/.config/shell/load-interactive.sh" ] && . "$HOME/.config/shell/load-interactive.sh"

# enable zsh tab completions engine
autoload -Uz compinit && compinit -C

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# legacy version managers, only if installed
command -v fnm >/dev/null 2>&1 && { eval "$(fnm env)"; alias nvm="fnm"; }
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init -)"
command -v jenv >/dev/null 2>&1 && { eval "$(jenv init -)"; export JAVA_HOME="$(jenv javahome)"; }
#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
true
